# Database
POSTGRES_USER=pamawas
POSTGRES_PASSWORD=pamawas
POSTGRES_DB=pamawas

# LLM Configuration (for investigator)
# Get from https://platform.openai.com/api-keys or use Ollama/vLLM/OpenRouter
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Delivery Channels (for reporter)
# Discord: Create webhook in Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# Telegram: Create bot via @BotFather, get chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email: SMTP or transactional (SES, Postmark, etc.)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# OpenTelemetry / Tempo
OTEL_EXPORTER_OTLP_ENDPOINT=tempo:4317