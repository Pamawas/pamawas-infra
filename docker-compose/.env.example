# Pamawas Core Infrastructure - Environment Variables
# Copy to .env and fill in required values

# ============================================================
# REQUIRED: Database
# ============================================================
POSTGRES_USER=pamawas
POSTGRES_PASSWORD=pamawas
POSTGRES_DB=pamawas

# ============================================================
# REQUIRED: LLM (for investigator)
# ============================================================
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ============================================================
# OPTIONAL: External Observability Stack
# Set these if you have Prometheus/Loki/Tempo/Grafana running elsewhere
# If empty, observability features are gracefully disabled
# ============================================================
PROMETHEUS_URL=http://your-prometheus:9090
LOKI_URL=http://your-loki:3100
TEMPO_OTLP_ENDPOINT=your-tempo:4317
GRAFANA_URL=http://your-grafana:3000

# ============================================================
# OPTIONAL: Delivery Channels (reporter)
# ============================================================
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=